<Window x:Class="TANGERINE_ZIP.IsoCreationWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner" WindowState="Normal"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="descriptionText" Grid.Row="0" TextWrapping="Wrap" Margin="4,4,4,12" />
        <TextBlock x:Name="volumeLabel" Grid.Row="1" Margin="4,4,4,4" />
        <TextBox x:Name="volumeBox" Grid.Row="2" Text="TANGERINE_ZIP" Margin="4" />
        <TextBlock x:Name="manufacturerLabel" Grid.Row="3" Margin="4,8,4,4" />
        <TextBox x:Name="manufacturerBox" Grid.Row="4" Margin="4" />
        <WrapPanel Grid.Row="5" Margin="4,8,4,4">
            <CheckBox x:Name="jolietCheck" IsChecked="True" Margin="0,0,16,4" />
            <CheckBox x:Name="deduplicateCheck" Margin="0,0,16,4" />
            <CheckBox x:Name="bootableCheck" Checked="Bootable_Changed" Unchecked="Bootable_Changed" />
        </WrapPanel>
        <Grid x:Name="bootPanel" Grid.Row="6" Margin="4,8,4,4" IsEnabled="False">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="bootImageLabel" Grid.Row="0" Margin="0,0,0,4" />
            <Grid Grid.Row="1"><Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
                <TextBox x:Name="bootImageBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                <Button x:Name="chooseBootImageButton" Grid.Column="1" Margin="8,0,0,0" Click="ChooseBootImage_Click" />
            </Grid>
        </Grid>
        <Grid Grid.Row="7" Margin="4,4,4,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock x:Name="emulationLabel" Margin="0,0,0,4" />
                <ComboBox x:Name="emulationCombo" SelectedIndex="0">
                    <ComboBoxItem Tag="NoEmulation" /><ComboBoxItem Tag="Diskette1200KiB" />
                    <ComboBoxItem Tag="Diskette1440KiB" /><ComboBoxItem Tag="Diskette2880KiB" />
                    <ComboBoxItem Tag="HardDisk" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock x:Name="segmentLabel" Margin="0,0,0,4" />
                <TextBox x:Name="segmentBox" Text="0" />
            </StackPanel>
        </Grid>
        <CheckBox x:Name="isolinuxCheck" Grid.Row="8" Margin="4,8,4,4" />
        <TextBlock x:Name="bootNote" Grid.Row="9" TextWrapping="Wrap" Margin="4,12,4,4" />
        <UniformGrid Grid.Row="10" Columns="2" Margin="4,12,4,0">
            <Button x:Name="confirmButton" IsDefault="True" Click="Confirm_Click" />
            <Button x:Name="cancelButton" IsCancel="True" Click="Cancel_Click" />
        </UniformGrid>
    </Grid>
</Window>
