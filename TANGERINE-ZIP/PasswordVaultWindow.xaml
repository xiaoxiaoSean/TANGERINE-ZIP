<Window x:Class="TANGERINE_ZIP.PasswordVaultWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <DockPanel Margin="14">
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="saveButton" Click="Save_Click" />
            <Button x:Name="useButton" Click="Use_Click" />
            <Button x:Name="deleteButton" Click="Delete_Click" />
            <Button x:Name="closeButton" IsCancel="True" Click="Close_Click" />
        </WrapPanel>
        <StackPanel>
            <TextBlock x:Name="descriptionText" TextWrapping="Wrap" Margin="4,4,4,12" />
            <TextBlock x:Name="savedLabel" Margin="4" />
            <ComboBox x:Name="savedCombo" Margin="4,0,4,8" SelectionChanged="SavedCombo_SelectionChanged" />
            <TextBlock x:Name="nameLabel" Margin="4" />
            <TextBox x:Name="nameBox" Margin="4,0,4,8" />
            <TextBlock x:Name="passwordLabel" Margin="4" />
            <PasswordBox x:Name="passwordBox" Margin="4,0,4,8" />
        </StackPanel>
    </DockPanel>
</Window>
