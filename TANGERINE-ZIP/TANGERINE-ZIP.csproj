<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>TANGERINE_ZIP</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>655049f4-4e69-449c-824a-293a9573c864</UserSecretsId>
    <NeutralLanguage>en-US</NeutralLanguage>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TANGERINE-ZIP.SmokeTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Devedse.DiscUtils.Iso9660" Version="1.0.107" />
    <PackageReference Include="Joveler.Compression.XZ" Version="5.0.2" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="ManagedWimLib" Version="2.6.0" />
    <PackageReference Include="SharpCompress" Version="0.50.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\TZIPResource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TZIPResource.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="LanguageManager\LanguageResource.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="LanguageManager\LanguageResource.zh-CN.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\TZIPResource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>TZIPResource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
