<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>

		<RootNamespace>TANGERINE_ZIP</RootNamespace>

		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>

		<UserSecretsId>655049f4-4e69-449c-824a-293a9573c864</UserSecretsId>

		<!-- 默认资源语言 -->
		<NeutralLanguage>en-US</NeutralLanguage>

		<!-- 发布目标 -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>

		<!-- .NET 官方单文件发布 -->
		<PublishSingleFile>true</PublishSingleFile>

		<!-- 将 Native DLL 尽可能打入单文件 -->
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

		<!-- 对单文件中的程序集进行压缩 -->
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

		<!-- WinForms / 反射类库较多，不建议开启 Trim -->
		<PublishTrimmed>false</PublishTrimmed>

		<!-- 不输出调试符号 -->
		<DebugType>None</DebugType>
		<DebugSymbols>false</DebugSymbols>

		<!-- 只发布需要的卫星语言资源 -->
		<SatelliteResourceLanguages>en-US;zh-CN</SatelliteResourceLanguages>

		<!-- 自定义条件编译参数 -->
		<ENABLE_LIGHT Condition="'$(ENABLE_LIGHT)' == ''">false</ENABLE_LIGHT>
		<DefineConstants Condition="'$(ENABLE_LIGHT)' == 'true'">
			$(DefineConstants);ENABLE_LIGHT
		</DefineConstants>
	</PropertyGroup>


	<!-- SmokeTests 可以访问内部成员 -->
	<ItemGroup>
		<InternalsVisibleTo Include="TANGERINE-ZIP.SmokeTests" />
	</ItemGroup>


	<!-- NuGet -->
	<ItemGroup>

		<PackageReference Include="Devedse.DiscUtils.Iso9660" Version="1.0.107" />

		<PackageReference Include="Joveler.Compression.XZ" Version="5.0.2" />

		<PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />

		<PackageReference Include="ManagedWimLib" Version="2.6.0" />

		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />

		<PackageReference Include="SharpCompress" Version="0.50.1" />

		<!-- Fody -->

		<!-- 将托管依赖嵌入主程序集 -->

	</ItemGroup>


	<!-- 自动生成资源 Designer -->
	<ItemGroup>
		<Compile Update="Resources\TZIPResource.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>TZIPResource.resx</DependentUpon>
		</Compile>
	</ItemGroup>


	<!-- 资源 -->
	<ItemGroup>

		<EmbeddedResource Update="LanguageManager\LanguageResource.resx">
			<Generator></Generator>
		</EmbeddedResource>

		<EmbeddedResource Update="LanguageManager\LanguageResource.zh-CN.resx">
			<Generator></Generator>
		</EmbeddedResource>

		<EmbeddedResource Update="Resources\TZIPResource.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>TZIPResource.Designer.cs</LastGenOutput>
		</EmbeddedResource>

	</ItemGroup>
</Project>