<Window x:Class="TANGERINE_ZIP.EncodingChoiceWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="440" Height="180"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}" FontFamily="Microsoft YaHei UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <StackPanel Margin="14">
        <TextBlock x:Name="descriptionText" Margin="4" />
        <ComboBox x:Name="encodingCombo" SelectedIndex="0" Margin="4">
            <ComboBoxItem Content="UTF-8" Tag="utf-8" />
            <ComboBoxItem Content="GB18030" Tag="GB18030" />
            <ComboBoxItem Content="GBK (CP936)" Tag="936" />
            <ComboBoxItem Content="Big5 (CP950)" Tag="950" />
            <ComboBoxItem Content="Shift-JIS (CP932)" Tag="932" />
            <ComboBoxItem Content="Windows-1252" Tag="1252" />
        </ComboBox>
        <Button x:Name="confirmButton" HorizontalAlignment="Right" Click="Confirm_Click" />
    </StackPanel>
</Window>
