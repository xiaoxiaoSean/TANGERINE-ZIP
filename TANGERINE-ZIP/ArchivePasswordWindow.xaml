<Window x:Class="TANGERINE_ZIP.ArchivePasswordWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archive password" SizeToContent="Height" WindowState="Normal" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="Black" Foreground="WhiteSmoke" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="18">
        <TextBlock x:Name="descriptionText" Text="Enter or create an archive password" Margin="4" />
        <CheckBox x:Name="_enablePassword" Content="Enable archive password" Margin="4" />
        <TextBlock x:Name="passwordText" Text="Password" Margin="4" />
        <Grid Margin="4">
            <PasswordBox x:Name="_password" />
            <TextBox x:Name="_visiblePassword" Visibility="Collapsed" />
        </Grid>
        <StackPanel x:Name="confirmationFields">
            <TextBlock x:Name="confirmationText" Text="Confirm password" Margin="4" />
            <Grid Margin="4">
                <PasswordBox x:Name="_confirmButtonation" />
                <TextBox x:Name="_visibleConfirmation" Visibility="Collapsed" />
            </Grid>
        </StackPanel>
        <CheckBox x:Name="_showPassword" Content="Show password" Margin="4,10,4,4" />
        <TextBlock x:Name="errorText" Foreground="OrangeRed" Visibility="Collapsed" Margin="4" />
        <UniformGrid Columns="2" Margin="0,12,0,0">
            <Button x:Name="confirmButton" Content="Confirm" IsDefault="True" Click="Confirm_Click" />
            <Button x:Name="cancelButton" Content="Cancel" IsCancel="True" Click="Cancel_Click" />
        </UniformGrid>
    </StackPanel>
</Window>
