<Window x:Class="TANGERINE_ZIP.ErrorDialogWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterOwner">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <DockPanel Margin="18">
        <Button x:Name="closeButton" DockPanel.Dock="Bottom" HorizontalAlignment="Right"
                Margin="0,14,0,0" Click="Close_Click" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="diagnosticText" Margin="4" TextWrapping="Wrap"
                       Foreground="{DynamicResource ForegroundBrush}" />
        </ScrollViewer>
    </DockPanel>
</Window>
