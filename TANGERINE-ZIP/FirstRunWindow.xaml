<Window x:Class="TANGERINE_ZIP.FirstRunWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="First-run setup" Icon="Resources/TZIP.png" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Microsoft YaHei UI" ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="headingText" Grid.Row="0" FontWeight="SemiBold" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,14" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="descriptionText" TextWrapping="Wrap" VerticalAlignment="Top" />
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,12">
            <TextBlock x:Name="statusText" Margin="0,0,0,8" />
            <ProgressBar x:Name="setupProgress" Minimum="0" Maximum="100" />
        </StackPanel>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="agreeButton" Grid.Column="0" Click="AgreeButton_Click" />
            <Button x:Name="declineButton" Grid.Column="1" Click="DeclineButton_Click" />
        </Grid>
    </Grid>
</Window>
