<Window x:Class="TANGERINE_ZIP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TZIP" Icon="Resources/TZIP.png" WindowState="Normal" WindowStartupLocation="CenterScreen"
        Background="Black" Foreground="WhiteSmoke" FontFamily="Microsoft YaHei UI"
        Loaded="MainWindow_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.75*" />
            <RowDefinition Height="8.5*" />
            <RowDefinition Height="0.75*" />
        </Grid.RowDefinitions>
        <Menu x:Name="menuBar" Grid.Row="0" Background="Black" Foreground="WhiteSmoke">
            <MenuItem x:Name="aboutMenuItem" Header="TZIP" Click="AboutMenu_Click" />
            <MenuItem x:Name="openArchiveMenuItem" Header="Open" Click="OpenArchiveMenu_Click" />
            <MenuItem x:Name="extractMenuItem" Header="Extract">
                <MenuItem x:Name="extractAllHereMenuItem" Header="Extract all" Click="ExtractAllHereMenu_Click" />
                <MenuItem x:Name="extractAllToFolderMenuItem" Header="Extract all to folder" Click="ExtractAllToFolderMenu_Click" />
                <MenuItem x:Name="extractSelectedHereMenuItem" Header="Extract selected" Click="ExtractSelectedHereMenu_Click" />
                <MenuItem x:Name="extractSelectedToFolderMenuItem" Header="Extract selected to folder" Click="ExtractSelectedToFolderMenu_Click" />
            </MenuItem>
            <MenuItem x:Name="compressMenuItem" Header="Compress">
                <MenuItem x:Name="compressFilesMenuItem" Header="Select files" Click="CompressFilesMenu_Click" />
            </MenuItem>
            <MenuItem x:Name="settingsMenuItem" Header="Settings" Click="SettingsMenu_Click" />
            <MenuItem x:Name="unloadArchiveMenuItem" Header="Unload" Click="UnloadArchiveMenu_Click" />
        </Menu>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBlock x:Name="archiveHeaderText" Text="TZIP" Margin="8" />
            </Border>
            <ListBox x:Name="archiveEntriesList" Grid.Row="1" SelectionMode="Extended" MouseDoubleClick="ArchiveEntriesList_MouseDoubleClick" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="operationProgressBar" Grid.Column="0" Minimum="0" Maximum="100" />
            <TextBlock x:Name="operationStatusText" Grid.Column="1" Text="Ready" Margin="4" />
        </Grid>
    </Grid>
</Window>
