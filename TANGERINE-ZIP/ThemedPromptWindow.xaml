<Window x:Class="TANGERINE_ZIP.ThemedPromptWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <DockPanel Margin="18">
        <WrapPanel x:Name="buttonsPanel" DockPanel.Dock="Bottom"
                    HorizontalAlignment="Right" Margin="0,14,0,0" />
        <ScrollViewer Background="{DynamicResource BackgroundBrush}"
                      VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="messageText" Margin="4" TextWrapping="Wrap"
                       Foreground="{DynamicResource ForegroundBrush}" />
        </ScrollViewer>
    </DockPanel>
</Window>
